{
  "name": "dsh-lerobot-dataset-inspector",
  "version": "0.1.0",
  "description": "Read-only DSH plugin for inspecting LeRobot dataset metadata and episode manifests",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": "./src/index.mjs",
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "dependencies": {
    "hyparquet": "1.31.5"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
